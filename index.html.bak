<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>A Little Promise for You</title>

  <!-- Fonts: Outfit and Fredoka from Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="style.css" rel="stylesheet">

  <!-- Tailwind CSS: a few helper classes used inside the card -->
  <script src="script.js"></script>

  <!-- Canvas-Confetti: the confetti bursts -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

  <!-- Our own files -->
  <style>
/* ==========================================================
   COLORS - edit these to change the look of the whole page
   ========================================================== */
:root {
  --bg1: #fff4f5;
  --bg2: #ffdfe4;
  --bg3: #ffffff;
  --ink: #5a0b1c;
  --muted: #8a3a4b;
  --glass: rgba(255, 255, 255, .62);
  --glass-b: rgba(255, 255, 255, .92);
  --env: #fff8f8;
  --env2: #f3bcc7;
  --env3: #f1d0d6;
  --red: #c8102e;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg1: #2b0812;
    --bg2: #3d0a18;
    --bg3: #1c0409;
    --ink: #fff0f2;
    --muted: #f2bcc6;
    --glass: rgba(110, 15, 40, .45);
    --glass-b: rgba(255, 255, 255, .2);
  }
}

:root[data-theme="dark"] {
  --bg1: #2b0812;
  --bg2: #3d0a18;
  --bg3: #1c0409;
  --ink: #fff0f2;
  --muted: #f2bcc6;
  --glass: rgba(110, 15, 40, .45);
  --glass-b: rgba(255, 255, 255, .2);
}

:root {
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
}

html {
  scroll-padding-top: env(safe-area-inset-top, 0px);
}

*,
*::before,
*::after {
  box-sizing: inherit;
}

[hidden] {
  display: none !important;
}

/* ==========================================================
   PAGE BASICS
   ========================================================== */
body {
  margin: 0;
  min-height: 100dvh;
  font-family: 'Outfit', system-ui, sans-serif;
  color: var(--ink);
  background: linear-gradient(160deg, var(--bg1), var(--bg2) 55%, var(--bg3));
  background-color: var(--bg2);
j background-attachment: fixed;
  overflow-x: hidden;
}

h1,
h2,
.fred {
  font-family: 'Fredoka', 'Outfit', system-ui, sans-serif;
}

:focus-visible {
  outline: 3px solid var(--ink);
  outline-offset: 4px;
  border-radius: 14px;
}

main {
  position: relative;
  z-index: 1;
  display: grid;
  place-items: center;
  min-height: 100dvh;
  padding: 1rem;
}

main > section {
  grid-area: 1/1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ==========================================================
   floating background hearts
   ========================================================== */
.bgh {
  position: fixed;
  bottom: -10vh;
  z-index: 0;
  pointer-events: none;
  color: var(--red);
  opacity: .28;
  animation: drift linear infinite;
}

@keyframes drift {
  to {
    transform: translateY(-115vh) rotate(25deg);
  }
}

/* ==========================================================
   Envelope stage
   ========================================================== */
#stage {
  gap: 2.5rem;
  padding-top: 7rem;
  transition:
    opacity .5s ease,
    transform .5s ease;
}

#stage.gone {
  opacity: 0;
  transform: translateY(20px);
  pointer-events: none;
}

#env {
  all: unset;
  cursor: pointer;
  display: block;
  position: relative;
  width: min(86vw, 340px);
  aspect-ratio: 4/3;
  perspective: 900px;
  animation: float 3.6s ease-in-out infinite;
  -webkit-tap-highlight-color: transparent;
}

#env:focus-visible {
  outline: 3px solid var(--ink);
  outline-offset: 10px;
  border-radius: 14px;
}

#stage.open #env {
  animation: none;
}

@keyframes float {
  50% {
    transform: translateY(-8px) rotate(-1deg);
  }
}

#env > span {
  position: absolute;
  display: block;
}

.e-back {
  inset: 0;
  background: var(--env2);
  border-radius: 12px;
  z-index: 0;
  box-shadow: 0 20px 40px -18px rgba(150, 20, 50, .45);
}

.e-ring {
  left: 50%;
  top: 14%;
  width: 48%;
  margin-left: -24%;
  z-index: 1;
  opacity: 0;
  transform: translateY(45%) scale(.5);
  transition:
    transform .9s cubic-bezier(.3, 1.8, .5, 1) .4s,
    opacity .2s .4s;
}

#stage.open .e-ring {
  opacity: 1;
  transform: translateY(-95%) scale(1);
}

.e-ring svg {
  display: block;
  width: 100%;
  animation: bob 2.4s ease-in-out infinite;
}

.e-pocket {
  inset: 0;
  background: linear-gradient(180deg, var(--env), var(--env3));
  border-radius: 12px;
  z-index: 2;
  clip-path: polygon(0 0, 50% 56%, 100% 0, 100% 100%, 0 100%);
}

.e-flap {
  left: 0;
  right: 0;
  top: 0;
  height: 56%;
  z-index: 3;
  background: linear-gradient(180deg, var(--env3), var(--env));
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  transform-origin: top;
  transition:
    transform .6s ease,
    z-index 0s .3s;
}

#stage.open .e-flap {
  transform: rotateX(180deg);
  z-index: 0;
  filter: brightness(.96);
}

.e-seal {
  left: 50%;
  top: 38%;
  width: 44px;
  height: 44px;
  margin: -22px 0 0 -22px;
  z-index: 4;
  border-radius: 50%;
  background: var(--red);
  color: #fff;
  display: flex !important;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, .2);
  transition: opacity .2s;
  animation: beat 1.4s ease-in-out infinite;
}

#stage.open .e-seal {
  opacity: 0;
}

@keyframes beat {
  50% {
    transform: scale(1.15);
  }
}

.hint {
  font-family: 'Fredoka', sans-serif;
  font-size: 1.1rem;
  color: var(--muted);
  text-align: center;
}

/* ==========================================================
   Ring card
   ========================================================== */
#card {
  max-width: 26rem;
  opacity: 0;
  transform: scale(.9) translateY(14px);
  transition:
    opacity .6s ease,
    transform .8s cubic-bezier(.2, 1.4, .4, 1);
}

#card.show {
  opacity: 1;
  transform: none;
}

.glass {
  background: var(--glass);
  border: 1px solid var(--glass-b);
  -webkit-backdrop-filter: blur(18px) saturate(1.3);
  backdrop-filter: blur(18px) saturate(1.3);
  border-radius: 32px;
  box-shadow: 0 24px 50px -24px rgba(150, 20, 50, .45);
}

#ringBtn {
  all: unset;
  display: block;
  cursor: pointer;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  transform-origin: 50% 62%;
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
  border-radius: 50%;
}

#ringBtn:focus-visible {
  outline: 3px solid var(--ink);
  outline-offset: 4px;
}

#card.show #ringBtn {
  animation: popin 1s cubic-bezier(.2, 1.7, .4, 1) .25s both;
}

@keyframes popin {
  from {
    transform: scale(.1) rotate(-60deg);
    opacity: 0;
  }
  to {
    transform: none;
    opacity: 1;
  }
}

#ringBox {
  animation: bob 3s ease-in-out infinite;
}

#ringBox svg,
.e-ring svg {
  overflow: visible;
}

#ringBox svg {
  display: block;
  width: 100%;
  filter: drop-shadow(0 12px 14px rgba(150, 20, 50, .25));
}

@keyframes bob {
  0%, 100% {
    transform: translateY(0) rotate(-3deg);
  }
  50% {
    transform: translateY(-10px) rotate(3deg);
  }
}

.jump {
  animation: jump .8s ease both;
}

@keyframes jump {
  0% {
    transform: none;
  }
  20% {
    transform: scale(1.12, .86);
  }
  45% {
    transform: translateY(-34px) rotate(-14deg) scale(.96, 1.08);
  }
  70% {
    transform: scale(1.1, .9) rotate(8deg);
  }
  100% {
    transform: none;
  }
}

.sp {
  transform-box: fill-box;
  transform-origin: center;
  animation: twinkle 2s ease-in-out infinite;
}

@keyframes twinkle {
  0%, 100% {
    transform: scale(.3) rotate(0);
    opacity: .2;
  }
  50% {
    transform: scale(1) rotate(45deg);
    opacity: 1;
  }
}

.eo {
  transform-box: fill-box;
  transform-origin: center;
  animation: blink 4s infinite;
}

@keyframes blink {
  0%, 92%, 100% {
    transform: scaleY(1);
  }
  95% {
    transform: scaleY(.1);
  }
}

.eh {
  opacity: 0;
  transition: opacity .2s;
}

.unlocked .eh {
  opacity: 1;
}

.unlocked .eo {
  opacity: 0;
}

.fh {
  position: absolute;
  color: var(--red);
  pointer-events: none;
  opacity: 0;
  animation: rise 2.2s ease-out forwards;
}

@keyframes rise {
  10% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translate(var(--dx), -240px) scale(1.1) rotate(20deg);
  }
}

/* ==========================================================
   ring slides onto a finger after "Yes"
   ========================================================== */
#ringStage {
  --w: min(62vw, 230px);
  position: relative;
  width: var(--w);
  height: var(--w);
  margin: .6rem auto 0;
  transition: height .8s ease .1s;
}

#ringStage.wear {
  height: calc(var(--w)*1.45);
}

#ringStage.wear #ringBtn {
  animation: shrinkOn 1s ease-in .9s forwards;
  pointer-events: none;
}

.hand {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  display: block;
  opacity: 0;
  transform: translateY(25%);
}

.wear .hand {
  animation:
    handUp .9s cubic-bezier(.2, .9, .3, 1) .25s forwards,
    handBob 3.2s ease-in-out 3s infinite;
}

.worn {
  opacity: 0;
}

.wear .worn {
  animation: wearIn 1.1s cubic-bezier(.3, .9, .3, 1) 1.6s forwards;
}

.hsp {
  opacity: 0;
  transform-box: fill-box;
  transform-origin: center;
}

.wear .hsp {
  animation: twinkle 1.8s ease-in-out infinite;
}

@keyframes shrinkOn {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  60% {
    transform: translate(-8%, 8%) scale(.22);
    opacity: 1;
  }
  85% {
    transform: translate(-8%, 8%) scale(.22);
    opacity: 1;
  }
  100% {
    transform: translate(-8%, 8%) scale(.22);
    opacity: 0;
  }
}

@keyframes handUp {
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes handBob {
  0%, 100% {
    transform: none;
  }
  50% {
    transform: translateY(-6px) rotate(2deg);
  }
}

@keyframes wearIn {
  0% {
    opacity: 0;
    transform: translateY(-44px);
  }
  12% {
    opacity: 1;
  }
  100% {
    opacity: 1;
    transform: none;
  }
}

/* ==========================================================
   flowers that bloom in the background after the envelope is tapped
   ========================================================== */
.flower {
  position: fixed;
  z-index: 0;
  pointer-events: none;
  width: var(--s);
  height: var(--s);
  opacity: .9;
  animation:
    bloom .9s cubic-bezier(.2, 1.7, .4, 1) var(--d) both,
    sway 5s ease-in-out calc(var(--d) + .9s) infinite alternate;
}

.flower svg {
  display: block;
  width: 100%;
  height: 100%;
}

@keyframes bloom {
  from {
    transform: scale(0) rotate(-120deg);
    opacity: 0;
  }
  to {
    transform: scale(1) rotate(calc(var(--r) - 6deg));
    opacity: .9;
  }
}

@keyframes sway {
  from {
    transform: rotate(calc(var(--r) - 6deg)) translateY(0);
  }
  to {
    transform: rotate(calc(var(--r) + 6deg)) translateY(-8px);
  }
}

.btn {
  min-height: 56px;
  padding: 0 1.5rem;
  border-radius: 999px;
  font-family: 'Fredoka', sans-serif;
  font-weight: 500;
  font-size: 1.1rem;
  cursor: pointer;
  transition: transform .15s ease;
  box-shadow: 0 10px 20px -10px rgba(150, 20, 50, .6);
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
}

.btn:active {
  transform: scale(.95);
}

.btn-a {
  background: var(--red);
  color: #fff;
  border: 2px solid var(--red);
}

.btn-b {
  background: #fff;
  color: var(--red);
  border: 2px solid var(--red);
}

.secret {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows .8s ease;
}

.secret > div {
  overflow: hidden;
}

.unlocked .secret {
  grid-template-rows: 1fr;
}

.secret p {
  opacity: 0;
  transform: translateY(10px);
  transition:
    opacity .7s ease .3s,
    transform .7s ease .3s;
}

.unlocked .secret p {
  opacity: 1;
  transform: none;
}

@media (prefers-reduced-motion: reduce) {
  * {
    animation: none !important;
    transition-duration: .01ms !important;
  }
  .bgh,
  .fh {
    display: none;
  }
  .eh {
    opacity: 0;
  }
  #ringStage {
    transition: none;
  }
  .wear .hand {
    opacity: 1;
    transform: none;
  }
  .wear .worn {
    opacity: 1;
  }
  .wear #ringBtn {
    opacity: 0;
  }
}
</style>
</head>
<body>

<main>
  <!-- SCREEN 1: the envelope -->
  <section id="stage" aria-label="Envelope">
    <button id="env" type="button" aria-label="Open your envelope">
      <span class="e-back"></span>
      <span class="e-ring" id="popRing"></span>
      <span class="e-pocket"></span>
      <span class="e-flap"></span>
      <span class="e-seal" aria-hidden="true">♥</span>
    </button>
    <p class="hint">Tap the envelope, I made you something</p>
  </section>

  <!-- SCREEN 2: the ring card -->
  <section id="card" hidden aria-label="Promise ring">
    <div class="glass relative overflow-hidden px-6 py-8 sm:px-10 text-center w-full" id="ringCard">
      <div id="hearts" aria-hidden="true"></div>
      <h1 class="text-3xl sm:text-4xl font-medium leading-tight">HAPPY BIRTHDAYYYYY, <span data-name></span>!</h1>
      <div id="ringStage">
        <button id="ringBtn" type="button" aria-label="Poke the ring"><div id="jumper"><div id="ringBox"></div></div></button>
        <svg class="hand" viewBox="0 0 200 240" aria-hidden="true">
          <!-- an open hand: four fingers and a thumb, back of the hand facing us -->
          <g fill="#ffd9c7">
            <rect x="46" y="108" width="22" height="70" rx="11" />
            <rect x="72" y="82" width="24" height="96" rx="12" />
            <rect x="100" y="72" width="25" height="106" rx="12.5" />
            <rect x="129" y="86" width="24" height="92" rx="12" />
            <!-- thumb: starts low on the palm and angles up and out -->
            <ellipse cx="157" cy="180" rx="11.500" ry="26" transform="rotate(40 157 180)" />
            <rect x="44" y="150" width="112" height="74" rx="30" />
          </g>
          <!-- fingernails -->
          <g fill="#ffbcc6">
            <rect x="50" y="111" width="14" height="14" rx="7" />
            <rect x="77" y="85" width="14" height="14" rx="7" />
            <rect x="105.500" y="75" width="14" height="14" rx="7" />
            <rect x="134" y="89" width="14" height="14" rx="7" />
            <ellipse cx="171" cy="163" rx="5.500" ry="6.500" transform="rotate(40 171 163)" />
          </g>
          <!-- little face on the back of the hand -->
          <circle cx="86" cy="190" r="3" fill="#3a0610" />
          <circle cx="114" cy="190" r="3" fill="#3a0610" />
          <ellipse cx="76" cy="198" rx="6" ry="3.5" fill="#ffa7b6" />
          <ellipse cx="124" cy="198" rx="6" ry="3.5" fill="#ffa7b6" />
          <path d="M94 197q6 6 12 0" stroke="#3a0610" stroke-width="2.2" fill="none" stroke-linecap="round" />
          <!-- cherry red sleeve with a white cuff -->
          <rect x="50" y="214" width="100" height="45" rx="10" fill="#c8102e" />
          <rect x="50" y="214" width="100" height="11" rx="4" fill="#fff" />
          <!-- the ring that slides down the ring finger -->
          <g class="worn">
            <g transform="translate(84 130)">
              <ellipse rx="12.500" ry="5.500" fill="none" stroke="#e0a93a" stroke-width="5" />
              <ellipse rx="12.500" ry="5.500" fill="none" stroke="#fff1bd" stroke-width="1.300" stroke-dasharray="12 70" stroke-linecap="round" />
              <path d="M0 8C-15 -1 -13 -15 0 -8C13 -15 15 -1 0 8Z" transform="translate(0 -5) scale(.55)" fill="#d3123a" stroke="#a30d2b" stroke-width="2.400" stroke-linejoin="round" />
            </g>
          </g>
          <!-- sparkles -->
          <g fill="#f5b83d">
            <g transform="translate(54 114)"><path class="hsp" style="animation-delay:2.9s" d="M0-7L2-2L7 0L2 2L0 7L-2 2L-7 0L-2-2Z" /></g>
            <g transform="translate(112 112)"><path class="hsp" style="animation-delay:3.1s" d="M0-7L2-2L7 0L2 2L0 7L-2 2L-7 0L-2-2Z" /></g>
            <g transform="translate(66 152)"><path class="hsp" style="animation-delay:3.3s" d="M0-7L2-2L7 0L2 2L0 7L-2 2L-7 0L-2-2Z" /></g>
          </g>
        </svg>
      </div>
      <!----<p class="fred text-sm mt-1" style="color:var(--muted)">(poke it, it loves attention)</p>--->
      <h2 class="mt-4 text-2xl font-medium">A little promise, just for you</h2>
      <p class="mt-2 mx-auto max-w-sm" style="color:var(--muted);line-height:1.65">MERI JAAN HAPPY BIRTHDAYYYYYYYYY I LOVE YOU SOOOO MUCHH EVER SINCE THE DAY WE MET I'VE ALWAYS FELT SOO HAPPY, SPECIAL, LOVED AND UNDERSTOOD. YOU'RE THE BEST THING THAT HAS EVER HAPPENED TO ME I LOVE YOUU SOOO MUCHHHH. WILL YOU WEAR THIS LITTLE PROMISE FOR MEE???</p>

      <div class="mt-6 flex flex-col gap-3">
        <button class="btn btn-a" type="button" data-yes>HAAANJIIIIIII QABUL HAIN🥰🥰🥰🥰🥰🥰🥰🥰</button>
        <button class="btn btn-b" type="button" data-yes>AFKARSEEEEEEE AAPSE NIKAHHHHHH DONEEE 🥰🥰🥰🥰🥰</button>
      </div>

      <!-- the hidden message, revealed after "Yes" -->
      <div class="secret" aria-live="polite">
        <div><p class="fred mt-6 text-xl leading-snug" id="secretMsg"></p></div>
      </div>
    </div>
  </section>
</main>

  <script>
/* ==========================================================
   SETTINGS - change these two lines to personalize the page
   ========================================================== */
const NAME = 'MERI JAAN';
const SECRET_MESSAGE = "YAYYYYYYYYYYYYYYYYYYYYYYYYYY YIPPPPPPPPPPIEEEEEEEEEEEEEE HAPPY BIRTHDAYYYY MERI JAAANNN I LOVE YOUUU SOOO MUCHH AAP TOH MERE FAVORITE PERSON HOOOO YIPPPPPPPPPPIEEEEEEEEEEEEEEIEIEIEI MWAHHH MWAH MWAH MWAHHHH 🥰🥰🥰 AB TOHHH AAP STUCK WITH MEEEE MUEHEHEHEHEH 😈😈😈😈😈 ";


/* ==========================================================
   SETUP - shortcuts and things we reuse later
   ========================================================== */

// A short name for document.querySelector, so we can type $('#id')
function $(selector) {
  return document.querySelector(selector);
}

// Some people turn on "reduce motion" in their device settings.
// When this is true, we skip the fancy animations.
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

// The colors used for the confetti pieces
const CONFETTI_COLORS = ['#c8102e', '#e8435f', '#ff7a90', '#ffffff', '#ffd6dc', '#e6b655'];

// The main parts of the page that we need to control
const stage = $('#stage');          // the screen with the envelope
const envelope = $('#env');         // the envelope button
const card = $('#card');            // the screen with the ring card
const ringCard = $('#ringCard');    // the glass box inside the card
const ringButton = $('#ringBtn');   // the ring you can poke
const ringJumper = $('#jumper');    // wrapper we animate when the ring jumps
const heartsBox = $('#hearts');     // where the floating hearts appear


/* ==========================================================
   STEP 1 - Put the name on the page
   ========================================================== */
function fillInName() {
  const nameSpots = document.querySelectorAll('[data-name]');
  nameSpots.forEach(function (spot) {
    spot.textContent = NAME;
  });
}


/* ==========================================================
   STEP 2 - Draw the cute ring (an SVG picture made with code)
   ========================================================== */

// One little twinkling star at position x, y
// "delay" makes each star start its twinkle at a different time
function buildSparkle(x, y, delay) {
  return `
    <g transform="translate(${x} ${y})">
      <path class="sp"
            style="animation-delay: ${delay}s"
            d="M0-9L2.5-2.5L9 0L2.5 2.5L0 9L-2.5 2.5L-9 0L-2.5-2.5Z"
            fill="#f5b83d" />
    </g>`;
}

// Builds the whole ring picture and returns it as text.
// Note: text inside backticks ` ` can contain ${ } to insert values.
function buildRingSvg() {
  const sparkles =
    buildSparkle(30, 44, 0) +
    buildSparkle(172, 56, 0.6) +
    buildSparkle(22, 136, 1.1) +
    buildSparkle(178, 146, 0.3) +
    buildSparkle(148, 14, 1.5);

  // The gold band, plus a thin shiny highlight on top of it
  const band = `
    <circle cx="100" cy="124" r="50" fill="none" stroke="#e0a93a" stroke-width="15" />
    <circle cx="100" cy="124" r="50" fill="none" stroke="#fff1bd" stroke-width="3.5"
            stroke-dasharray="34 280" stroke-dashoffset="-170" stroke-linecap="round" />`;

  // The red heart-shaped gem, with a small white shine
  const gem = `
    <path d="M100 86C60 62 68 24 100 46C132 24 140 62 100 86Z"
          fill="#d3123a" stroke="#a30d2b" stroke-width="3" stroke-linejoin="round" />
    <path d="M82 40q-9 4-8 14" stroke="#fff" stroke-width="4" fill="none"
          stroke-linecap="round" opacity="0.8" />`;

  // Two eye styles: open (blinking) eyes, and happy "^ ^" eyes.
  // The CSS decides which one is visible.
  const openEyes = `
    <g class="eo">
      <circle cx="90" cy="60" r="3.6" fill="#3a0610" />
      <circle cx="110" cy="60" r="3.6" fill="#3a0610" />
    </g>`;
  const happyEyes = `
    <g class="eh" fill="none" stroke="#3a0610" stroke-width="2.8" stroke-linecap="round">
      <path d="M85 62q5-8 10 0" />
      <path d="M105 62q5-8 10 0" />
    </g>`;

  // Rosy cheeks and a smile
  const cheeksAndSmile = `
    <ellipse cx="82" cy="68" rx="5" ry="3" fill="#ff9fb0" />
    <ellipse cx="118" cy="68" rx="5" ry="3" fill="#ff9fb0" />
    <path d="M95 68q5 5 10 0" stroke="#3a0610" stroke-width="2.4" fill="none"
          stroke-linecap="round" />`;

  // Put all the pieces together inside one <svg> picture
  return `
    <svg viewBox="0 0 200 200" role="img"
         aria-label="A cute gold promise ring with a smiling red heart gem">
      ${sparkles}
      ${band}
      ${gem}
      ${openEyes}
      ${happyEyes}
      ${cheeksAndSmile}
    </svg>`;
}

// The ring appears twice: popping out of the envelope, and on the card.
function drawRings() {
  $('#popRing').innerHTML = buildRingSvg();
  $('#ringBox').innerHTML = buildRingSvg();
}


/* ==========================================================
   STEP 3 - Soft hearts that drift up the background
   ========================================================== */
function addBackgroundHearts() {
  if (reduceMotion) {
    return; // no moving hearts for people who asked for less motion
  }

  const howMany = 14;

  for (let i = 0; i < howMany; i++) {
    const heart = document.createElement('span');
    heart.className = 'bgh';
    heart.textContent = '♥';
    heart.setAttribute('aria-hidden', 'true'); // screen readers skip decoration

    // Random position, size and speed so the hearts look natural
    heart.style.left = Math.random() * 100 + '%';
    heart.style.fontSize = 14 + Math.random() * 26 + 'px';
    heart.style.animationDuration = 12 + Math.random() * 14 + 's';
    heart.style.animationDelay = -Math.random() * 20 + 's';

    document.body.appendChild(heart);
  }
}


/* ==========================================================
   STEP 4 - Her favorite flowers bloom in the background
   (hibiscus and pansies, drawn with code just like the ring)
   ========================================================== */

// Five petals in a circle. The same oval is turned by 72 degrees each time.
function buildPetals(width, height, offset) {
  const turns = [0, 72, 144, 216, 288];
  return turns.map(function (angle) {
    return `<ellipse cx="0" cy="${offset}" rx="${width}" ry="${height}" transform="rotate(${angle})" />`;
  }).join('');
}

// A red hibiscus with a tiny smiling face in the middle
function buildHibiscusSvg() {
  return `
    <svg viewBox="0 0 120 120" aria-hidden="true">
      <g transform="translate(60 62)">
        <g fill="#c8102e">${buildPetals(17, 25, -25)}</g>
        <g fill="#e8435f" opacity="0.55">${buildPetals(7, 15, -28)}</g>
        <path d="M0 0Q12-20 22-34" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" />
        <g fill="#f6c453">
          <circle cx="22" cy="-34" r="3.5" />
          <circle cx="16" cy="-30" r="2.5" />
          <circle cx="26" cy="-28" r="2.5" />
        </g>
        <circle r="11" fill="#6e0a1b" />
        <circle cx="-4" cy="-1" r="1.8" fill="#fff" />
        <circle cx="4" cy="-1" r="1.8" fill="#fff" />
        <path d="M-3 3Q0 6 3 3" stroke="#fff" stroke-width="1.5" fill="none" stroke-linecap="round" />
        <ellipse cx="-8" cy="3" rx="2.5" ry="1.5" fill="#ff9fb0" />
        <ellipse cx="8" cy="3" rx="2.5" ry="1.5" fill="#ff9fb0" />
      </g>
    </svg>`;
}

// A white pansy with red markings and a tiny smiling face
function buildPansySvg() {
  return `
    <svg viewBox="0 0 120 120" aria-hidden="true">
      <g stroke="#e6aab6" stroke-width="1.5" fill="#fff">
        <ellipse cx="42" cy="40" rx="21" ry="24" transform="rotate(-18 42 40)" />
        <ellipse cx="78" cy="40" rx="21" ry="24" transform="rotate(18 78 40)" />
        <ellipse cx="30" cy="68" rx="19" ry="20" />
        <ellipse cx="90" cy="68" rx="19" ry="20" />
        <ellipse cx="60" cy="86" rx="24" ry="21" />
      </g>
      <g fill="#c8102e">
        <ellipse cx="60" cy="88" rx="15" ry="13" />
        <ellipse cx="34" cy="70" rx="9" ry="10" />
        <ellipse cx="86" cy="70" rx="9" ry="10" />
      </g>
      <path d="M60 70V84M54 71L49 82M66 71L71 82" stroke="#6e0a1b" stroke-width="1.6" stroke-linecap="round" />
      <circle cx="60" cy="62" r="9" fill="#f6c453" stroke="#6e0a1b" stroke-width="2" />
      <circle cx="56.5" cy="60.5" r="1.4" fill="#3a0610" />
      <circle cx="63.5" cy="60.5" r="1.4" fill="#3a0610" />
      <path d="M57 64.5Q60 67.5 63 64.5" stroke="#3a0610" stroke-width="1.3" fill="none" stroke-linecap="round" />
      <ellipse cx="53" cy="64" rx="2.2" ry="1.4" fill="#ff9fb0" />
      <ellipse cx="67" cy="64" rx="2.2" ry="1.4" fill="#ff9fb0" />
    </svg>`;
}

// Scatter flowers around the page. CSS makes each one bloom, then sway.
const FLOWER_COUNT = 40;

function plantFlowers() {
  for (let i = 0; i < FLOWER_COUNT; i++) {
    const flower = document.createElement('div');
    flower.className = 'flower';
    flower.setAttribute('aria-hidden', 'true');

    // Alternate between the two flowers: hibiscus, pansy, hibiscus, ...
    flower.innerHTML = (i % 2 === 0) ? buildHibiscusSvg() : buildPansySvg();

    // Random place, size, tilt and start time so it looks like a real garden
    flower.style.left = Math.random() * 92 + '%';
    flower.style.top = Math.random() * 90 + '%';
    flower.style.setProperty('--s', 46 + Math.random() * 40 + 'px');
    flower.style.setProperty('--r', Math.random() * 60 - 30 + 'deg');
    flower.style.setProperty('--d', Math.random() * 1.8 + 's');

    document.body.appendChild(flower);
  }
}


/* ==========================================================
   STEP 5 - Opening the envelope
   The order of events:
     1. the flap opens and the ring pops out
     2. a small confetti burst
     3. the envelope fades away
     4. the ring card appears in the same spot
   ========================================================== */

// Waiting times in milliseconds (shorter if motion is reduced)
const TIME_CONFETTI = reduceMotion ? 0 : 800;
const TIME_FADE_ENVELOPE = reduceMotion ? 100 : 2400;
const TIME_SHOW_CARD = reduceMotion ? 200 : 2950;

function smallConfettiBurst() {
  confetti({
    particleCount: 40,
    spread: 80,
    startVelocity: 28,
    origin: { x: 0.5, y: 0.45 },
    colors: CONFETTI_COLORS,
    zIndex: 1000,
    disableForReducedMotion: true
  });
}

function showCard() {
  stage.hidden = true;  // remove the envelope screen completely
  card.hidden = false;  // show the card screen

  // Wait two frames so the browser can play the "appear" animation
  requestAnimationFrame(function () {
    requestAnimationFrame(function () {
      card.classList.add('show');
    });
  });
}

function openEnvelope() {
  envelope.disabled = true;        // stop extra taps
  stage.classList.add('open');     // CSS opens the flap and pops out the ring

  plantFlowers();                  // the flowers start blooming in the background
  setTimeout(smallConfettiBurst, TIME_CONFETTI);
  setTimeout(function () { stage.classList.add('gone'); }, TIME_FADE_ENVELOPE);
  setTimeout(showCard, TIME_SHOW_CARD);
}


/* ==========================================================
   STEP 6 - Poking the ring
   ========================================================== */

// Little hearts that float up from the ring
function makeFloatingHearts(count) {
  if (reduceMotion) {
    return;
  }

  for (let i = 0; i < count; i++) {
    const heart = document.createElement('span');
    heart.className = 'fh';
    heart.textContent = '♥';

    // Start somewhere near the ring, with a random size and sideways drift
    heart.style.left = 35 + Math.random() * 30 + '%';
    heart.style.top = 32 + Math.random() * 12 + '%';
    heart.style.fontSize = 14 + Math.random() * 18 + 'px';
    heart.style.animationDelay = Math.random() * 0.5 + 's';
    heart.style.setProperty('--dx', (Math.random() - 0.5) * 140 + 'px');

    heartsBox.appendChild(heart);

    // Clean up: remove the heart after its animation is done
    setTimeout(function () { heart.remove(); }, 3000);
  }
}

// Make the ring squish and hop
function makeRingJump() {
  ringJumper.classList.remove('jump');
  void ringJumper.offsetWidth;  // forces the browser to reset, so the animation can replay
  ringJumper.classList.add('jump');
}

function pokeRing() {
  makeRingJump();
  makeFloatingHearts(6);
}


/* ==========================================================
   STEP 7 - The ring slides onto a finger
   All the movement is done by CSS. We just add the class
   "wear" and the hand appears, the ring shrinks onto the
   fingertip, then slides down the finger.
   ========================================================== */
function slideRingOntoFinger() {
  $('#ringStage').classList.add('wear');
}


/* ==========================================================
   STEP 8 - Clicking "Yes!"
   ========================================================== */

// Several confetti bursts, one after another
function bigConfettiShow() {
  // Settings shared by every burst
  const base = {
    colors: CONFETTI_COLORS,
    zIndex: 1000,
    ticks: 240,
    disableForReducedMotion: true
  };

  // Try to make heart-shaped confetti. If that fails, use plain circles.
  let heartShapes = ['circle'];
  try {
    heartShapes = [confetti.shapeFromText({ text: '❤️', scalar: 2 }), 'circle'];
  } catch (error) {
    // nothing to do, we keep the circles
  }

  // Burst 1: from the middle, right away
  confetti({ ...base, particleCount: 90, spread: 80, origin: { x: 0.5, y: 0.72 } });

  // Burst 2: from the left edge
  setTimeout(function () {
    confetti({ ...base, particleCount: 60, angle: 60, spread: 65, origin: { x: 0, y: 0.85 } });
  }, 250);

  // Burst 3: from the right edge
  setTimeout(function () {
    confetti({ ...base, particleCount: 60, angle: 120, spread: 65, origin: { x: 1, y: 0.85 } });
  }, 400);

  // Burst 4: floating hearts
  setTimeout(function () {
    confetti({
      ...base,
      particleCount: 28,
      spread: 360,
      startVelocity: 22,
      gravity: 0.6,
      scalar: 2,
      shapes: heartShapes,
      origin: { x: 0.5, y: 0.4 }
    });
  }, 650);

  // Burst 5: the big finish
  setTimeout(function () {
    confetti({ ...base, particleCount: 120, spread: 110, startVelocity: 45, origin: { x: 0.5, y: 0.6 } });
  }, 950);
}

function sayYes() {
  // Write the secret message and unlock it (CSS slides it open)
  $('#secretMsg').textContent = SECRET_MESSAGE;
  ringCard.classList.add('unlocked');

  makeRingJump();
  makeFloatingHearts(16);
  slideRingOntoFinger();
  bigConfettiShow();

  // After a moment, scroll so the message is in view (helps on small phones)
  setTimeout(function () {
    $('#secretMsg').scrollIntoView({
      behavior: reduceMotion ? 'auto' : 'smooth',
      block: 'center'
    });
  }, 3200);
}


/* ==========================================================
   START - run the setup and connect the buttons
   ========================================================== */
fillInName();
drawRings();
addBackgroundHearts();

envelope.addEventListener('click', openEnvelope);
ringButton.addEventListener('click', pokeRing);

// Both "Yes" buttons do the same thing
document.querySelectorAll('[data-yes]').forEach(function (button) {
  button.addEventListener('click', sayYes);
});
</script>
</body>
</html>
